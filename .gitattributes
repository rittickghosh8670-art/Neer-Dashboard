# Ensure Linux-targeted files always use LF line endings, even when checked
# out on Windows (default git behavior can convert to CRLF, which breaks
# Docker image builds and shell scripts running inside Linux containers).

* text=auto eol=lf

*.sh text eol=lf
*.sql text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-specific scripts should keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary files - do not touch
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.jar binary
